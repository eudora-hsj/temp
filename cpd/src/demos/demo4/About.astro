---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<header class="sec page-head">
  <div class="wrap wrap--4">
    {entry.data.eyebrow && <p class="volume">{entry.data.eyebrow}</p>}
    <h1 class="page-head__title">{entry.data.title}</h1>
    {entry.data.lead && <p class="page-head__lead">{entry.data.lead}</p>}
    <div class="ornate"></div>
  </div>
</header>

<section class="sec" style="border-top:0;padding-top:0">
  <div class="wrap wrap--4">
    <article class="prose">
      <Content />
    </article>
  </div>
</section>
