---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Demo, Lang, OutputEntry } from '../../lib/content';
import { slugOf } from '../../lib/content';
import { formatDate, t } from '../../i18n/ui';
import { url } from '../../lib/paths';

interface Props {
  lang: Lang;
  demo: Demo;
  entry: CollectionEntry<'pages'>;
  outputs: OutputEntry[];
}

const { lang, demo, entry, outputs } = Astro.props;
const { Content } = await render(entry);
const s = t(lang);
---

<header class="page-head">
  <div class="shell">
    {entry.data.eyebrow && <p class="eyebrow">{entry.data.eyebrow}</p>}
    <h1 class="page-head__title">{entry.data.title}</h1>
    {entry.data.lead && <p class="page-head__lead">{entry.data.lead}</p>}
  </div>
</header>

<div class="page-body">
  <div class="shell">
    <article class="prose">
      <Content />
    </article>

    <p class="label" style="margin-top:3rem">{s.outputs.count(outputs.length)}</p>

    {
      outputs.length === 0 ? (
        <p class="prose">{s.outputs.empty}</p>
      ) : (
        <div class="output-list">
          {outputs.map((item) => (
            <article class="output-row">
              <div class="output-row__meta">
                <div>{formatDate(item.data.date, lang)}</div>
                <div>{s.category[item.data.category]}</div>
              </div>
              <div>
                <h2 class="output-row__title">
                  <a href={url(demo, lang, `outputs/${slugOf(item.id)}`)}>{item.data.title}</a>
                </h2>
                <p class="output-row__summary">{item.data.summary}</p>
                <div class="tag-row">
                  <span class="tag tag--accent">{s.region[item.data.region]}</span>
                  {item.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</div>
