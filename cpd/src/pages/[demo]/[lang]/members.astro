---
import { DEMOS, LANGS, getMembers, getPage, type Demo, type Lang } from '../../../lib/content';
import { registry } from '../../../registry';

export function getStaticPaths() {
  return DEMOS.flatMap((demo) => LANGS.map((lang) => ({ params: { demo, lang } })));
}

const { demo, lang } = Astro.params as { demo: Demo; lang: Lang };
const { Layout, Members } = registry[demo];
const [entry, members] = await Promise.all([getPage(lang, 'members'), getMembers(lang)]);
---

<Layout lang={lang} demo={demo} title={entry.data.title} description={entry.data.lead}>
  <Members lang={lang} entry={entry} members={members} />
</Layout>
